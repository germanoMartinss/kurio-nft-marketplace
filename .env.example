# Copie para .env.local e ajuste se necessário. Nenhuma variável aqui é segredo:
# o projeto não tem backend real, toda a API é simulada pelo MSW.

# Ativa a camada de mocks (MSW): REST via service worker e Socket.IO via interceptação de WebSocket.
# Padrão: true (inclusive no build de demonstração da Vercel). Use false apenas para apontar para
# um backend real compatível com os contratos.
VITE_ENABLE_MOCKS=true

# Base das chamadas REST feitas pelo Axios. Relativa à origem da aplicação.
VITE_API_BASE_URL=/api

# Origem do servidor Socket.IO. Vazio = mesma origem da aplicação (o mock intercepta
# wss://<origem>/realtime/).
VITE_SOCKET_URL=
